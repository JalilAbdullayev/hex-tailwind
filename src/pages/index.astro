---
import "../styles/global.css";
import ColorToTailwind from "../components/ColorToTailwind";
import FeedbackForm from "../components/FeedbackForm";
import Link from "../components/Link.astro";
import HexCodeInUrlNotifier from "../components/HexInUrlNotifier";
import ThemeToggle from "../components/ThemeToggle";

const title =
  "Color to Tailwind — Convert HEX, RGB, HSL to Tailwind CSS Colors";
const description =
  "Find the closest Tailwind CSS color for any HEX, RGB, or HSL value. A free online converter with support for Tailwind v1–v4 palettes.";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const image = "/meta.webp";
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Color to Tailwind" />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();

      if (theme === "light") {
        document.documentElement.classList.remove("dark");
      } else {
        document.documentElement.classList.add("dark");
      }
      window.localStorage.setItem("theme", theme);
    </script>
  </head>
  <body
    class="min-h-screen overflow-x-hidden font-sans antialiased transition-colors duration-300 bg-linear-to-br from-indigo-50 via-white to-purple-50 text-slate-900 selection:bg-indigo-100 selection:text-indigo-900 dark:from-slate-950 dark:via-slate-900 dark:to-indigo-950 dark:text-slate-100 dark:selection:bg-indigo-500/30 dark:selection:text-indigo-200"
  >
    <header
      class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-md dark:border-indigo-900/40 dark:bg-slate-950/70"
    >
      <div class="container flex items-center justify-between px-4 py-3">
        <a
          href="/"
          class="text-sm font-bold tracking-tight text-slate-800 dark:text-slate-100"
        >
          Color to Tailwind
        </a>
        <ThemeToggle client:load />
      </div>
    </header>
    <main class="container p-4 mt-8 mb-24 space-y-8 md:mt-12 md:space-y-12">
      <section class="mb-4 text-center md:mb-8">
        <h1 class="mb-4">
          <span
            class="block text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-linear-to-r from-indigo-600 to-purple-600 dark:from-indigo-400 dark:to-purple-400 sm:text-6xl md:text-7xl drop-shadow-sm"
          >
            Color to Tailwind
          </span>
          <span
            class="mt-3 block text-lg font-semibold tracking-tight text-slate-600 sm:text-xl md:text-2xl dark:text-slate-400"
          >
            Convert HEX, RGB, HSL to Tailwind CSS Colors
          </span>
        </h1>
        <a
          href="#how-it-works"
          class="text-sm font-semibold text-indigo-600 hover:text-indigo-700 dark:text-indigo-400 dark:hover:text-indigo-300"
        >
          How it works
        </a>
      </section>
      <ColorToTailwind client:load url={canonicalURL.toString()} />
      <HexCodeInUrlNotifier client:only="react" />
      <div class="grid grid-cols-1 gap-8 mt-12 md:grid-cols-2">
        <section
          id="how-it-works"
          class="p-8 transition-shadow duration-300 border border-white shadow-xl dark:border-indigo-900/50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl shadow-indigo-100/40 dark:shadow-lg dark:shadow-indigo-950/40 rounded-3xl md:p-10 hover:shadow-2xl"
        >
          <h2
            class="mb-5 text-2xl font-bold tracking-tight text-slate-800 dark:text-slate-100"
          >
            How it works
          </h2>
          <div
            class="space-y-4 leading-relaxed text-slate-600 dark:text-slate-400"
          >
            <p>
              Type (or paste) your color code in the input box. We support HEX,
              RGB, HSL, named colors, and Tailwind tokens. The hashtag is optional for hex, so <code
                class="bg-slate-100 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 px-1.5 py-0.5 rounded-md font-mono text-sm shadow-sm"
              >
                #3B82F6
              </code>, <code
                class="bg-slate-100 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 px-1.5 py-0.5 rounded-md font-mono text-sm shadow-sm"
              >
                3B82F6
              </code>, or <code
                class="bg-slate-100 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 px-1.5 py-0.5 rounded-md font-mono text-sm shadow-sm"
              >
                rgb(59, 130, 246)
              </code> all work.
            </p>
            <p>
              We pick the closest Tailwind color with <span
                class="font-medium text-slate-700 dark:text-slate-300">Delta E</span>,
              a score for how different two colors look. If that score is above
              1, most people can see the gap.
            </p>
            <p>
              You get the closest token, how close the match is, and whether
              white or black text will read on it. Click to copy the class, the
              HEX, or a share link.
            </p>
            <p>
              Paste the real source color, not the one you already think is
              closest. Glance at the nearest matches before you copy — the
              closest number is not always the best fit on the page. If we
              suggest a custom <code
                class="bg-slate-100 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 px-1.5 py-0.5 rounded-md font-mono text-sm shadow-sm"
              >bg-[#…]</code> class, the built-in palette is probably too far
              from your brand color.
            </p>
          </div>
        </section>
        <section
          class="flex flex-col justify-between p-8 transition-shadow duration-300 border border-white shadow-xl dark:border-indigo-900/50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl shadow-indigo-100/40 dark:shadow-lg dark:shadow-indigo-950/40 rounded-3xl md:p-10 hover:shadow-2xl"
        >
          <div>
            <h2
              class="mb-5 text-2xl font-bold tracking-tight text-slate-800 dark:text-slate-100"
            >
              About the project
            </h2>
            <div
              class="space-y-4 leading-relaxed text-slate-600 dark:text-slate-400"
            >
              <p>
                This started as
                <Link url="https://hextotailwind.com/">
                  the original Hex to Tailwind
                </Link>, built by
                <Link url="https://github.com/mihailthebuilder/hex-tailwind">
                  Mihail
                </Link>
                so he could match brand colors to Tailwind without squinting at
                a palette.
              </p>
              <p>
                This version also looks up named colors and Tailwind tokens
                across v1–v4, shows nearby matches and contrast, and keeps the
                color plus version in the share link. You can batch-convert a
                list or paste your own palette.
              </p>
              <p class="pt-2">
                Built with <Link url="https://astro.build/">
                  <span
                    class="font-semibold text-indigo-500 hover:text-indigo-600 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300"
                  >
                    Astro
                  </span>
                </Link> and <Link url="https://react.dev/">
                  <span
                    class="font-semibold text-indigo-500 hover:text-indigo-600 hover:underline dark:text-indigo-400 dark:hover:text-indigo-300"
                  >
                    React
                  </span>
                </Link>. The code is open source.
              </p>
              <div class="flex flex-wrap gap-3 pt-4">
                <Link url="https://github.com/JalilAbdullayev/hex-tailwind/">
                  <span
                    class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-md hover:bg-indigo-700 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all dark:bg-indigo-500 dark:hover:bg-indigo-400"
                  >
                    View on GitHub
                  </span>
                </Link>
                <Link url="https://github.com/mihailthebuilder/hex-tailwind">
                  <span
                    class="inline-flex items-center justify-center rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white shadow-md hover:bg-slate-800 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-offset-2 focus-visible:outline-slate-900 transition-all dark:bg-slate-700 dark:hover:bg-slate-600"
                  >
                    Original project
                  </span>
                </Link>
              </div>
            </div>
          </div>
        </section>
      </div>
      <section
        class="relative p-8 mt-12 mb-8 overflow-hidden border bg-indigo-50/70 dark:bg-indigo-950/20 border-indigo-100/50 dark:border-indigo-900/50 shadow-input rounded-3xl md:p-12"
      >
        <div
          class="absolute inset-bs-0 inset-e-0 size-64 -mt-20 -me-20 rounded-full pointer-events-none bg-purple-100/50 dark:bg-purple-900/20 blur-3xl"
        >
        </div>
        <div class="relative z-10 mx-auto text-center">
          <h2
            class="mb-3 text-3xl font-bold tracking-tight text-slate-800 dark:text-slate-100"
          >
            Questions or feedback?
          </h2>
          <p class="mb-8 text-lg text-slate-600 dark:text-slate-400">
            Have an idea on how to make this tool better? Let us know below.
          </p>
          <div
            class="p-6 text-left transition-shadow border border-white shadow-sm dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 backdrop-blur-md md:p-8 rounded-2xl hover:shadow-md"
          >
            <FeedbackForm client:load />
          </div>
        </div>
      </section>
    </main>
    <footer
      class="py-12 text-sm font-medium text-center text-slate-500 dark:text-slate-400"
    >
      <p>Copyright Tuxedo Software {new Date().getFullYear()}</p>
    </footer>
    <script is:inline src="https://web3forms.com/client/script.js" async defer
    ></script>
  </body>
</html>
